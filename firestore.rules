rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isStudent() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
      // Allow students to update their own passwordChanged status if needed (though usually handled by admin or a function)
      allow update: if isSignedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordChanged']);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Submissions collection
    match /submissions/{taskId}/entries/{studentId} {
      allow read: if isAdmin() || (isStudent() && request.auth.uid == studentId);
      allow create: if isStudent()
        && request.auth.uid == studentId
        && !('grade' in request.resource.data)
        && !('feedback' in request.resource.data);
      allow update: if isAdmin()
        || (isStudent()
            && request.auth.uid == studentId
            && !('grade' in resource.data)
            && (
              !('deadline' in get(/databases/$(database)/documents/tasks/$(taskId)).data)
              || get(/databases/$(database)/documents/tasks/$(taskId)).data.deadline == null
              || get(/databases/$(database)/documents/tasks/$(taskId)).data.deadline > request.time
            )
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'submittedAt', 'studentId', 'studentPhone']));
      allow delete: if isAdmin();
    }

    // Notices collection
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Requests collection
    match /requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Students may create their own pending requests with a safe payload. Admins may create any request.
      allow create: if isAdmin()
        || (
          isStudent()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && !(request.resource.data.autoGenerated == true)
          && request.resource.data.requestedChapters is list
        );

      // Students may update their own pending request but only the requestedChapters (and updatedAt), and status must remain 'pending'. Admins can update freely.
      allow update: if isAdmin()
        || (
          isStudent()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.requestedChapters is list
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestedChapters', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Live sessions collection
    match /liveSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isStudent() && request.auth.uid == resource.data.studentId);
      allow create, update, delete: if false;
    }

    // Notifications — server (Admin SDK) is the only writer of new items;
    // clients may only flip their own items' `read` flag.
    match /notifications/{uid}/items/{itemId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Chat meta — last message preview + unread flags per room. Only the
    // server (Admin SDK, via /api/chats/touch-meta and mark-read routes)
    // writes this; clients only ever read it for live unread indicators.
    match /chats_meta/{roomId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == roomId);
      allow write: if false;
    }

    // Ephemeral chat — allow students to create their own messages and admins to create messages;
    // only admins may update or delete messages.
    match /chats/{studentId}/messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
      allow create: if (
        // Admins can create messages
        (isAdmin() && request.resource.data.senderId == request.auth.uid)
        ||
        // Students can create messages only in their own chat and must set senderId to their uid
        (isStudent() && request.auth.uid == studentId && request.resource.data.senderId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }
  }
}
