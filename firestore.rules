rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isStudent() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
      // Allow students to update their own passwordChanged status if needed (though usually handled by admin or a function)
      allow update: if isSignedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordChanged']);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Submissions collection
    match /submissions/{taskId}/entries/{studentId} {
      allow read: if isAdmin() || (isStudent() && request.auth.uid == studentId);
      allow create: if isStudent()
        && request.auth.uid == studentId
        && !('grade' in request.resource.data)
        && !('feedback' in request.resource.data);
      allow update: if isAdmin()
        || (isStudent()
            && request.auth.uid == studentId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'submittedAt', 'studentId', 'studentPhone']));
    }

    // Notices collection
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Requests collection
    match /requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isStudent();
      allow update: if isAdmin()
        || (isStudent()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Ephemeral chat — client read only; writes via Admin SDK / Socket server
    match /chats/{studentId}/messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
      allow write: if false;
    }
  }
}
